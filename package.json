{
  "name": "dsh-session-porter",
  "version": "1.0.0",
  "description": "Export every conversation to a folder you pick (OneDrive works) and import it back on another machine, with a per-session picker, an overwrite switch and a confirm dialog. · 一键把对话导出到你指定的目录（OneDrive 也行），换台电脑再一键导回来；支持逐个会话挑选、覆盖开关和确认弹窗。",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "assets",
    "cordis.patch.yml",
    "lib",
    "locale",
    "test"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "conversation",
    "export",
    "import",
    "backup",
    "sync",
    "onedrive",
    "portable"
  ],
  "author": "LZ-jun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LZ-jun/dsh-session-porter.git"
  },
  "homepage": "https://github.com/LZ-jun/dsh-session-porter#readme",
  "bugs": {
    "url": "https://github.com/LZ-jun/dsh-session-porter/issues"
  },
  "icon": "assets/icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/smoke-client.cjs"
  }
}